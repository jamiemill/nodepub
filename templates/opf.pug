mixin resources(resources)
  each resource, i in resources
    -
      const isCoverImage = (resource.properties || '').split(/\s+/).includes('cover-image');
      const itemId = isCoverImage ? 'cover-image' : `img${i}`;
    if resource.properties
      item(
        href=`resources/${resource.base}`,
        id=itemId,
        media-type=resource.type
        properties=resource.properties
      )
    else
      item(
        href=`resources/${resource.base}`,
        id=itemId,
        media-type=resource.type
      )

-
  let showContentsInSpine = data.options.showContentsInSpine;
  let coverType = data.options.coverType;
  let hasCoverDocument = coverType === 'text';
  let hasImageCover = coverType === 'image';
  let sections =data.sections;

doctype xml
package(
  prefix='cc: http://creativecommons.org/ns#'
  unique-identifier='pub-id',
  version='3.0',
  xml:lang=data.metadata.language,
  xmlns='http://www.idpf.org/2007/opf',
)
  metadata(
    xmlns:dc='http://purl.org/dc/elements/1.1/'
  )
    dc:title(
      id='title'
    )=data.metadata.title

    meta(
      property='title-type',
      refines='#title'
    )='main'

    each accessMode in data.metadata.accessMode
      meta(
        property='schema:accessMode'
      )=accessMode

    each accessModeSufficient in data.metadata.accessModeSufficient
      meta(
        property='schema:accessModeSufficient'
      )=accessModeSufficient

    each accessibilityFeature in data.metadata.accessibilityFeature
      meta(
        property='schema:accessibilityFeature'
      )=accessibilityFeature

    each accessibilityHazard in data.metadata.accessibilityHazard
      meta(
        property='schema:accessibilityHazard'
      )=accessibilityHazard

    if data.metadata.accessibilitySummary
      meta(
        property='schema:accessibilitySummary'
      )=data.metadata.accessibilitySummary

    dc:language=data.metadata.language
    dc:identifier(
      id='pub-id'
    )=data.metadata.id

    if data.metadata.author
      dc:creator(
        id='creator'
      )=data.metadata.author
      meta(
        property='role',
        refines='#creator'
      )='aut'

    if data.metadata.author && data.metadata.fileAs
      meta(
        property='file-as',
        refines='#creator'
      )=data.metadata.fileAs

    dc:date=data.metadata.published

    if data.metadata.description
      dc:description=data.metadata.description

    if data.metadata.publisher
      dc:publisher=data.metadata.publisher

    if data.metadata.copyright
      dc:rights=data.metadata.copyright

    if data.metadata.source
      dc:source=data.metadata.source

    if data.metadata.genre
      dc:subject=data.metadata.genre

    meta(
      property='dcterms:modified'
    )=data.metadata.modified

    each tag in data.metadata.tags
      dc:subject=tag

    if data.metadata.series
      meta(
        id='series',
        property='belongs-to-collection'
      )=data.metadata.series
      meta(
        property='collection-type',
        refines='#series'
      )='series'

      if data.metadata.sequence
        meta(
          property='group-position',
          refines='#series'
        )=data.metadata.sequence

    if data.metadata.series && data.metadata.sequence
      meta(
        content=data.metadata.series,
        name='calibre:series'
      )
      meta(
        content=data.metadata.sequence,
        name='calibre:series_index'
      )

    if hasImageCover
      meta(
        content='cover-image',
        name='cover'
      )

  manifest
    if hasCoverDocument
      item(
        href='cover.xhtml',
        id='cover',
        media-type='application/xhtml+xml'
      )

    item(
      href='css/ebook.css',
      id='style',
      media-type='text/css'
    )

    each section in sections
      item(
        href=`content/${section.filename}`,
        id=`s${section.index}`,
        media-type='application/xhtml+xml'
      )

    item(
      href='content/toc.xhtml',
      id='toc',
      media-type='application/xhtml+xml',
      properties='nav'
    )

    +resources(data.resources)

  spine
    if hasCoverDocument
      itemref(
        idref='cover',
        linear='yes'
      )

    each section in sections
      if section.isFrontMatter
        itemref(
          idref=`s${section.index}`
        )

    if showContentsInSpine
      itemref(
        idref='toc'
      )

    each section in sections
      unless section.isFrontMatter
        itemref(
          idref=`s${section.index}`
        )

  if hasCoverDocument || showContentsInSpine
    guide
      if hasCoverDocument
        reference(
          href='cover.xhtml',
          title='Cover',
          type='cover'
        )
      if showContentsInSpine
        reference(
          href='content/toc.xhtml',
          title='Contents',
          type='toc'
        )
