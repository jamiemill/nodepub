-
  let coverType = data.options.coverType;

doctype xml
| <!DOCTYPE html>
html(
  lang=data.metadata.language,
  xml:lang=data.metadata.language,
  xmlns:epub='http://www.idpf.org/2007/ops',
  xmlns='http://www.w3.org/1999/xhtml'
)
  head
    title=data.metadata.title
    link(
      href='css/ebook.css',
      rel='stylesheet',
      type='text/css'
    )
    meta(
      charset='utf-8'
    )

    if coverType === 'image'
      style(
        type='text/css'
      ).
        @page {
          padding: 0pt;
          margin: 0pt;
        }
        html, body {
          margin: 0;
          padding: 0;
          height: 100%;
        }
        body {
          text-align: center;
        }
        body img {
          max-width: 100%;
          max-height: 100%;
          width: auto;
          height: auto;
        }

  body(
    epub:type='cover'
  )
    if coverType === 'image'
      img(
        alt=data.metadata.coverAlt,
        src=`resources/${data.cover.base}`
      )
    else if coverText
      div!= coverText
