{
  "author": "Dylan Armstrong <dylan@dylan.is>",
  "bugs": {
    "url": "https://github.com/jamiemill/nodepub/issues"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "defaults": "^3.0.0",
    "mime": "^3.0.0",
    "pug": "^3.0.2",
    "uuid": "^9.0.1"
  },
  "description": "Create valid EPUB 3.3 ebooks with metadata, navigation, contents, covers, and resources.",
  "devDependencies": {
    "@daisy/ace": "1.4.6",
    "@dylanarmstrong/eslint-config": "^0.5.4",
    "@dylanarmstrong/tsconfig": "^0.0.2",
    "@jest/globals": "^29.7.0",
    "@types/archiver": "^5.3.4",
    "@types/jest": "^29.5.12",
    "@types/mime": "^3.0.4",
    "@types/node": "^20.11.16",
    "@types/pug": "^2.0.10",
    "@types/uuid": "^9.0.8",
    "@types/yauzl": "2.10.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "puppeteer": "24.43.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "yauzl": "3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "eslintConfig": {
    "extends": "@dylanarmstrong"
  },
  "exports": "./lib/index.js",
  "files": [
    "./lib/",
    "./templates/"
  ],
  "homepage": "https://github.com/jamiemill/nodepub",
  "keywords": [
    "epub",
    "ebook"
  ],
  "license": "MIT",
  "name": "@jamiemill/nodepub",
  "packageManager": "pnpm@8.15.9",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiemill/nodepub.git"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc",
    "example": "pnpm run build && pnpm run example:build && node --trace-uncaught example/example.js",
    "example:build": "tsc -p tsconfig.example.json",
    "lint": "pnpm run prettier && pnpm run lint:src && pnpm run lint:example && pnpm run lint:test",
    "lint:example": "eslint example/example.ts --fix",
    "lint:src": "eslint src/ --fix",
    "lint:test": "eslint __tests__/ --fix",
    "prepare": "pnpm run build",
    "prettier": "prettier --write --ignore-unknown src/ __tests__/ example/example.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "validate": "pnpm run build && node scripts/validate-fixtures.mjs"
  },
  "type": "module",
  "version": "4.3.0"
}
